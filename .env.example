# Server Configuration
PORT=8000
HOST=0.0.0.0
APP_ENV=development

# File Storage Directories
SESSION_STORAGE_DIR=temp/sessions
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
MAX_UPLOAD_SIZE_BYTES=524288000
WORKSPACE_TTL=24h

# Microsoft SQL Server 2022 Configuration
# Required outside isolated tests. Supply the real connection string securely.
MSSQL_CONNECTION_STRING=
# Or using Windows Authentication / Trusted Connection:
# MSSQL_CONNECTION_STRING=server=127.0.0.1;port=1433;database=veracity_maps;trusted_connection=yes;encrypt=disable

# Discrete MSSQL Variables (used if MSSQL_CONNECTION_STRING is not set)
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=veracity_maps
MSSQL_USER=
MSSQL_PASSWORD=

# Dedicated database only: integration tests apply migrations and write fixtures.
# Tests skip when absent and fail if the configured database cannot be reached.
MSSQL_TEST_CONNECTION_STRING=

# Verification/invitation mail configuration (required by the later mailer cutover).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_PUBLIC_URL=http://localhost:5173

