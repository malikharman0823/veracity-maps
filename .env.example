# ==============================================================================
# Veracity Maps — Environment Configuration
# Copy this file to `.env` in the repository root and customize as needed.
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
# Use "development" for local/LAN usage (falls back to local storage if MSSQL is offline).
# Use "production" to require a live MSSQL database and strict TLS verification.
APP_ENV=development
# Public URL of this application (single-server default: http://localhost:8000)
APP_PUBLIC_URL=http://localhost:8000

# Optional: Custom path to the built frontend SPA directory (defaults to ../frontend/dist)
# FRONTEND_DIST_DIR=

# File Storage Directories (relative to backend/ working directory)
SESSION_STORAGE_DIR=temp/sessions
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
MAX_UPLOAD_SIZE_BYTES=524288000
WORKSPACE_TTL=24h

# Default World Base Map (OpenStreetMap)
BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
BASEMAP_ATTRIBUTION=© OpenStreetMap contributors

# Microsoft SQL Server Configuration
# In development mode, if MSSQL is offline the server automatically uses local
# file-backed storage (storage/users/, storage/projects/, storage/published_maps.json).
# In production mode (APP_ENV=production), a reachable MSSQL instance is required.
MSSQL_CONNECTION_STRING=server=127.0.0.1;port=1433;database=veracity_maps;trusted_connection=yes;encrypt=disable

# Alternative discrete MSSQL variables (used only if MSSQL_CONNECTION_STRING is empty)
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=veracity_maps
MSSQL_USER=
MSSQL_PASSWORD=

# Dedicated test database (optional — integration tests skip if empty)
MSSQL_TEST_CONNECTION_STRING=

# Outbound Email Configuration (Standard SMTP for OTP & map invitations)
# Supports Gmail, Outlook, Brevo, Mailgun, SendGrid, or local Mailpit/Mailhog.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# For Gmail, generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@veracitymaps.com
SMTP_USE_TLS=false
